---
import { Dumbbell } from "lucide-react";
const { user } = Astro.locals;
---

<div
  class="border-border bg-card text-foreground mb-4 flex flex-wrap items-center justify-between gap-4 rounded-xl border px-4 py-3 text-sm"
>
  <a href="/" class="text-foreground flex items-center gap-2 text-xl font-bold tracking-tight">
    <Dumbbell className="text-primary size-7" />
    Treningo
  </a>
  {
    user ? (
      <div class="flex items-center gap-4">
        <span class="text-muted-foreground">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class="text-primary hover:text-primary/80 transition-colors hover:underline">
            Panel
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class="text-primary hover:text-primary/80 transition-colors hover:underline">
              Wyloguj
            </button>
          </form>
        </div>
      </div>
    ) : (
      <div class="flex items-center gap-4">
        <span class="text-muted-foreground">Niezalogowany</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-primary hover:text-primary/80 transition-colors hover:underline">
            Zaloguj się
          </a>
          <a href="/auth/signup" class="text-primary hover:text-primary/80 transition-colors hover:underline">
            Załóż konto
          </a>
        </div>
      </div>
    )
  }
</div>
