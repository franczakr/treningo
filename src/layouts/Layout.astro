---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { Dumbbell } from "lucide-react";

interface Props {
  title?: string;
}

const { title = "Treningo" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <Dumbbell className="text-foreground/[0.03] absolute -top-12 -left-16 size-72 rotate-[-18deg]" />
      <Dumbbell className="text-foreground/[0.03] absolute top-1/3 -right-20 size-80 rotate-[24deg]" />
      <Dumbbell className="text-foreground/[0.03] absolute bottom-[-4rem] left-1/4 size-64 rotate-[10deg]" />
    </div>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot name="nav" />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
