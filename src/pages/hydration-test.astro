---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import TrainingProfileForm from "@/components/profile/TrainingProfileForm";
---

<Layout title="Profil treningowy">
  <AppHeader slot="nav" />
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-foreground w-full max-w-lg rounded-2xl border p-8">
      <h1 class="mb-6 text-center text-2xl font-bold">Profil treningowy</h1>
      <TrainingProfileForm initial={null} serverError={null} saved={false} client:load />
    </div>
  </div>
</Layout>
