---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import { createClient } from "@/lib/supabase";
import { getPlans } from "@/lib/services/plans";
import { formatPlanDate } from "@/lib/format";
import { GOAL_OPTIONS, type SavedPlan } from "@/types";

// Middleware guarantees an authenticated user on this protected route. Plans are
// loaded server-side (RLS-scoped via the session); no client fetch.
const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let plans: SavedPlan[] = [];
if (supabase && user) {
  plans = await getPlans(supabase, user.id);
}

function goalLabel(plan: SavedPlan): string {
  return GOAL_OPTIONS.find((o) => o.value === plan.profile_snapshot.goal)?.label ?? plan.profile_snapshot.goal;
}

function displayName(plan: SavedPlan): string {
  return plan.name ?? goalLabel(plan);
}
---

<Layout title="Panel">
  <AppHeader slot="nav" />
  <div class="flex min-h-[calc(100vh-7rem)] items-start justify-center p-4">
    <div class="w-full max-w-2xl">
      <div class="border-border bg-card text-foreground rounded-2xl border p-8 text-center">
        <h1 class="mb-4 text-3xl font-bold">Panel</h1>
        <p class="text-muted-foreground">
          Witaj, <span class="text-foreground font-semibold">{user?.email}</span>
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a
            href="/plan"
            class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-lg px-4 py-2 text-sm font-medium transition-colors"
          >
            Generuj plan
          </a>
          <a
            href="/training-profile"
            class="border-input bg-background text-foreground hover:bg-accent inline-block rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
          >
            Edytuj profil treningowy
          </a>
        </div>
      </div>

      <h2 class="text-foreground mt-8 mb-3 text-xl font-semibold">Moje plany</h2>
      {
        plans.length === 0 ? (
          <p class="text-muted-foreground border-border bg-card rounded-2xl border p-6 text-center text-sm">
            Nie masz jeszcze zapisanych planów.
          </p>
        ) : (
          <ul class="space-y-3">
            {plans.map((plan) => (
              <li class="border-border bg-card rounded-2xl border p-2">
                <div class="flex items-center gap-2">
                  <a
                    href={`/plan/${plan.id}`}
                    class="text-foreground hover:bg-accent flex flex-1 items-center justify-between gap-4 rounded-xl p-3 transition-colors"
                  >
                    <span class="text-primary font-semibold">{displayName(plan)}</span>
                    <span class="text-muted-foreground text-sm">{formatPlanDate(plan.created_at)}</span>
                  </a>
                  <details class="relative">
                    <summary
                      class="text-muted-foreground hover:text-foreground hover:bg-accent list-none rounded-lg p-3 text-sm transition-colors [&::-webkit-details-marker]:hidden"
                      aria-label="Zmień nazwę planu"
                    >
                      Zmień nazwę
                    </summary>
                    <form
                      method="POST"
                      action="/api/plan/rename"
                      class="bg-card border-border absolute top-full right-0 z-10 mt-1 flex gap-2 rounded-xl border p-2 shadow-md"
                    >
                      <input type="hidden" name="plan_id" value={plan.id} />
                      <input
                        type="text"
                        name="name"
                        value={plan.name ?? ""}
                        placeholder={goalLabel(plan)}
                        maxlength="100"
                        class="border-input bg-background text-foreground rounded-lg border px-3 py-2 text-sm"
                      />
                      <button
                        type="submit"
                        class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-lg px-3 py-2 text-sm font-medium transition-colors"
                      >
                        Zapisz
                      </button>
                    </form>
                  </details>
                  <form method="POST" action="/api/plan/delete" onsubmit="return confirm('Usunąć ten plan?')">
                    <input type="hidden" name="plan_id" value={plan.id} />
                    <button
                      type="submit"
                      class="text-muted-foreground hover:text-destructive hover:bg-destructive/10 rounded-lg p-3 text-sm transition-colors"
                      aria-label="Usuń plan"
                    >
                      Usuń
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
