---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const { user } = Astro.locals;
---

<Layout title="Dashboard">
  <AppHeader slot="nav" />
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-foreground rounded-2xl border p-8 text-center">
      <h1 class="mb-4 text-3xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground">
        Welcome, <span class="text-foreground font-semibold">{user?.email}</span>
      </p>
      <p class="text-muted-foreground mt-2 text-sm">This page is only for authenticated users.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/plan"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-block rounded-lg px-4 py-2 text-sm font-medium transition-colors"
        >
          Generuj plan
        </a>
        <a
          href="/plans"
          class="border-input bg-background text-foreground hover:bg-accent inline-block rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
        >
          Moje plany
        </a>
        <a
          href="/training-profile"
          class="border-input bg-background text-foreground hover:bg-accent inline-block rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
        >
          Edytuj profil treningowy
        </a>
      </div>
    </div>
  </div>
</Layout>
