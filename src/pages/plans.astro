---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";
import { createClient } from "@/lib/supabase";
import { getPlans } from "@/lib/services/plans";
import { formatPlanDate } from "@/lib/format";
import { GOAL_OPTIONS, type SavedPlan } from "@/types";

// Middleware guarantees an authenticated user on this protected route. Plans are
// loaded server-side (RLS-scoped via the session); no client fetch.
const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let plans: SavedPlan[] = [];
if (supabase && user) {
  plans = await getPlans(supabase, user.id);
}

function goalLabel(plan: SavedPlan): string {
  return GOAL_OPTIONS.find((o) => o.value === plan.profile_snapshot.goal)?.label ?? plan.profile_snapshot.goal;
}
---

<Layout title="Moje plany">
  <AppHeader slot="nav" />
  <div class="flex min-h-screen items-start justify-center p-4">
    <div class="w-full max-w-2xl py-10">
      <h1 class="text-foreground mb-6 text-center text-3xl font-bold">Moje plany</h1>

      {
        plans.length === 0 ? (
          <div class="border-border bg-card text-foreground rounded-2xl border p-8 text-center">
            <p class="text-muted-foreground">Nie masz jeszcze zapisanych planów.</p>
            <a
              href="/plan"
              class="bg-primary text-primary-foreground hover:bg-primary/90 mt-6 inline-block rounded-lg px-4 py-2 text-sm font-medium transition-colors"
            >
              Generuj plan
            </a>
          </div>
        ) : (
          <ul class="space-y-3">
            {plans.map((plan) => (
              <li>
                <a
                  href={`/plan/${plan.id}`}
                  class="border-border bg-card text-foreground hover:bg-accent flex items-center justify-between gap-4 rounded-2xl border p-5 transition-colors"
                >
                  <span class="text-primary font-semibold">{goalLabel(plan)}</span>
                  <span class="text-muted-foreground text-sm">{formatPlanDate(plan.created_at)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</Layout>
